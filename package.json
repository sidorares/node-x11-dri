{
  "name": "x11-dri",
  "version": "0.4.0",
  "description": "Optional native companion to the pure-JS x11 package: direct OpenGL ES rendering (GBM/EGL, dlopen'd at runtime) and dma-buf plumbing (udmabuf, DMA_BUF sync, dup) for the DRI3 + Present path on Linux — and on macOS, the client half of XQuartz's Apple-DRI direct rendering (Xplugin + CGL), same gl API.",
  "author": "Andrey Sidorov <andrey.sidorov@gmail.com>",
  "license": "MIT",
  "main": "index.js",
  "homepage": "https://github.com/sidorares/node-x11-dri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorares/node-x11-dri.git"
  },
  "bugs": {
    "url": "https://github.com/sidorares/node-x11-dri/issues"
  },
  "keywords": [
    "x11",
    "dri3",
    "present",
    "dma-buf",
    "gbm",
    "egl",
    "opengl",
    "gles",
    "udmabuf",
    "direct rendering",
    "xquartz",
    "apple-dri",
    "cgl"
  ],
  "os": [
    "linux",
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.gyp",
    "src/",
    "scripts/",
    "prebuilds/",
    "test.js"
  ],
  "scripts": {
    "install": "node scripts/install.js",
    "test": "node test.js",
    "test:types": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "gypfile": true
}
